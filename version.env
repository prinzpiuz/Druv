# Pinned image versions for the homelab stack.
#
# Every tag here was verified to be the exact image the previous floating tag
# (latest / alpine / major-series) resolved to on 2026-10-21, except where a
# comment says otherwise.
#
# Compose does NOT read this file on its own. Either export
#   COMPOSE_ENV_FILES=.env,version.env
# or pass --env-file .env --env-file version.env. down_and_up.sh does this.
#
# To bump a version: change the value here, then `docker compose up -d <service>`.

# --- never-down.yml ---
UPTIME_KUMA_VERSION=2.5.6
BESZEL_VERSION=0.21.0
FILEBROWSER_VERSION=2.0.1-stable
COUCHDB_VERSION=3.5.2.1

# --- automation ---
# n8n `latest` tracks the stable release, which is behind the newest tag (2.45.0).
N8N_VERSION=2.44.5

# --- backup ---
BACKREST_VERSION=v1.14.1

# --- infra ---
DOCKER_SOCKET_PROXY_VERSION=v0.5.0
HOMEPAGE_VERSION=v2.6.0
MYSPEED_VERSION=1.0.9
BESZEL_AGENT_VERSION=0.21.0-alpine

# --- media ---
AUDIOBOOKSHELF_VERSION=2.37.1
JELLYFIN_VERSION=12.2.20261005-225228
JELLY_MUSIC_APP_VERSION=v1.0.5
SEERR_VERSION=v3.5.0

# --- tools ---
QDRANT_VERSION=v1.19.2
BENTOPDF_VERSION=v2.8.10
SNAPOTTER_VERSION=2.2.0
BLOTILS_VERSION=1.0.3
DAWARICH_VERSION=1.16.0
DAWARICH_REDIS_VERSION=7.4.11-alpine
DAWARICH_POSTGIS_VERSION=17-3.5-alpine
PRICESTALKER_POSTGRES_VERSION=16.15-alpine
PRICESTALKER_BACKEND_VERSION=2.0.0
PRICESTALKER_FRONTEND_VERSION=2.0.0

# --- arr ---
# gluetun `latest` is a rolling build off master, so no release tag matches it.
# v3.41.3 is the newest release; this is the one pin that changes the image.
GLUETUN_VERSION=v3.41.3
QBITTORRENT_VERSION=release-5.0.4
RADARR_VERSION=release-6.4.4.10685
SONARR_VERSION=release-4.0.20.3014
BAZARR_VERSION=release-1.6.2
SYNTHWAVE_VERSION=v1.0.7
# swurapp publishes only `latest` and `dev`, so it is pinned by digest instead.
SWURAPP_DIGEST=sha256:589412bbc23c7386a6f7fba578357ff536f25c94262ddd46ff2eae946cea5467
FLARESOLVERR_VERSION=v3.5.2
PROWLARR_VERSION=2.6.5.5623-ls165
JACKETT_VERSION=v0.24.2884-ls10
RECYCLARR_VERSION=8.8.0
UNPACKERR_VERSION=0.16.1
