# Pinned image versions for the public (VPS) stack.
#
# Tags verified on 2026-10-21 to be the exact images `alpine` / `latest`
# resolved to at that time.
#
# Compose does NOT read this file on its own; the deploy workflow exports
#   COMPOSE_ENV_FILES=.env,version.env
# before running `docker compose pull`. Do the same for manual runs.

CADDY_CLOUDFLARE_VERSION=2.11.7-alpine
BESZEL_AGENT_VERSION=0.21.0
