# CouchDB for Obsidian LiveSync. Publicly exposed, so it gets extra treatment:
# the admin surfaces are blocked outright and CouchDB's own headers stripped.
# Reach Fauxton over Tailscale instead:
#   http://100.83.118.50:5984/_utils
livesync.prinzpiuz.in {
	@admin path /_utils* /_membership* /_cluster_setup* /_node/* /_all_dbs /_active_tasks /_scheduler*
	respond @admin 404

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	handle_errors {
		respond "{err.status_code}"
	}

	reverse_proxy ${REVERSE_PROXY_URL}:5984 {
		header_down -Server
		header_down -X-CouchDB-Body-Time
		header_down -X-Couch-Request-ID
	}

	tls {
		dns cloudflare ${CLOUDFLARE_API_TOKEN}
	}
}
