# ---------------------------------------------------------------------------
# Snippets must come before any site block.
#
# envsubst note: it substitutes $VAR and ${VAR}. Caddy's {args[0]} and
# {err.status_code} contain no $, so they pass through untouched. Never use
# Caddy's {$ENV} form in this template — envsubst would consume it.
# ---------------------------------------------------------------------------

(secure) {
	header {
		# Caddy's own banner on responses it generates (errors, redirects)
		-Server
		-X-Powered-By

		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# Bare status code instead of a branded error page. Without this, a 502
	# announces the proxy software to anyone who probes a down service.
	handle_errors {
		respond "{err.status_code}"
	}
}

(proxy) {
	import secure

	reverse_proxy {args[0]} {
		# Banners the upstream application sends back. The -Server here is
		# separate from the one in (secure): that covers Caddy's own
		# responses, this covers pass-through responses.
		header_down -Server
		header_down -X-Powered-By
		header_down -X-AspNet-Version
		header_down -X-AspNetMvc-Version
		header_down -X-Runtime
		header_down -X-Generator
		header_down -X-Drupal-Cache
		header_down -X-Application-Context
	}

	tls {
		dns cloudflare ${CLOUDFLARE_API_TOKEN}
	}
}

